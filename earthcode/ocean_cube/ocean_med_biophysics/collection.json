      "title": "ESA Mediterranean Sea Datacube"
    }
  ],
  "stac_extensions": [
    "https://stac-extensions.github.io/datacube/v2.2.0/schema.json",
    "https://stac-extensions.github.io/file/v2.1.0/schema.json"
  ],
  "cube:dimensions": {
    "time": {
      "type": "temporal",
      "unit": "days since 2016-01-01 00:00:00"
    },
    "lat": {
      "type": "spatial",
      "axis": "y",
      "extent": [
        30.250000634939664,
        46.000001272408966
      ]
    },
    "lon": {
      "type": "spatial",
      "axis": "x",
      "extent": [
        -6.083331425041402,
        36.08333333239003
      ]
    },
    "depth": {
      "type": "vertical",
      "unit": "m",
      "description": "Depth below sea surface"
    }
  },
  "cube:variables": {
    "mlotst": {
      "type": "data",
      "dimensions": [
        "time",
        "lat",
        "lon"
      ],
      "unit": "m",
      "description": "Mixed layer depth from min of temperature and density threshold equivalent to a 0.2C decrease"
    },
    "PP": {
      "type": "data",
      "dimensions": [
        "time",
        "depth",
        "lat",
        "lon"
      ],
      "unit": "mg m-3 d-1",
      "description": "Primary Production field estimated from chlorophyll and temperature 3D fields [spatial resolution = 1/24 deg]"
    },
    "so": {
      "type": "data",
      "dimensions": [
        "time",
        "depth",
        "lat",
        "lon"
      ],
      "unit": "0.001",
      "description": "salinity"
    },
    "to": {
      "type": "data",
      "dimensions": [
        "time",
        "depth",
        "lat",
        "lon"
      ],
      "unit": "degrees_C",
      "description": "temperature"
    },
    "ugo": {
      "type": "data",
      "dimensions": [
        "time",
        "depth",
        "lat",
        "lon"
      ],
      "unit": "m s-1",
      "description": "geostrophic zonal velocity from thermal wind equation"
    },
    "vgo": {
      "type": "data",
      "dimensions": [
        "time",
        "depth",
        "lat",
        "lon"
      ],
      "unit": "m s-1",
      "description": "geostrophic meridional velocity from thermal wind equation"
    },
    "water_mask": {
      "type": "data",
      "dimensions": [
        "lat",
        "lon"
      ],
      "unit": "1",
      "description": "ESA WorldCover 2021 v200 water retention mask"
    },
    "ZEU": {
      "type": "data",
      "dimensions": [
        "time",
        "lat",
        "lon"
      ],
      "unit": "m",
      "description": "Euphotic Depth Estimaded by PP model"
    },
    "zo": {
      "type": "data",
      "dimensions": [
        "time",
        "depth",
        "lat",
        "lon"
      ],
      "unit": "m",
      "description": "absolute height"
    }
  },
  "subtitle": "3D daily biophysics variables across 18 depth levels",
